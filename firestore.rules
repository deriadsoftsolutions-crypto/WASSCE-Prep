rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    function test(aid) {
      return get(/databases/$(database)/documents/assessments/$(aid)).data;
    }
    function testOpen(aid) {
      let a = test(aid);
      return a.published == true
        && (a.opensAt == null || request.time >= a.opensAt)
        && (a.closesAt == null || request.time <= a.closesAt);
    }
    // Learners may see the answer key only after submitting, and only if the teacher allows it.
    function keyVisible(aid) {
      let a = test(aid);
      return exists(/databases/$(database)/documents/learners/$(request.auth.uid)/assessmentAttempts/$(aid))
        && (a.showResults == 'immediately'
            || (a.showResults == 'after-close' && a.closesAt != null && request.time > a.closesAt));
    }
    // Submissions must arrive within the time limit (plus 2 minutes' grace) and before closing (plus 2 minutes).
    function inTime(uid, aid) {
      let a = test(aid);
      let started = get(/databases/$(database)/documents/learners/$(uid)/assessmentStarts/$(aid)).data.startedAt;
      return (a.timeLimitMin == 0 || request.time <= started + duration.value(a.timeLimitMin * 60 + 120, 's'))
        && (a.closesAt == null || request.time <= a.closesAt + duration.value(120, 's'));
    }

    // Only you add teachers, by hand in the Firebase console.
    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Class-wide mock settings: everyone signed in can read, only teachers can change.
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // The school's fixed classes. Anyone can read the list (learners choose their class before signing in);
    // only teachers add, rename or retire classes.
    match /classes/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Each learner can only see and write their own data. Teachers can read everyone.
    // Once a learner is in a fixed class, only a teacher can change their class or year.
    function classUnchanged() {
      return request.resource.data.get('classId', null) == resource.data.get('classId', null)
        && request.resource.data.get('className', null) == resource.data.get('className', null)
        && request.resource.data.get('year', null) == resource.data.get('year', null)
        && request.resource.data.get('loginKey', null) == resource.data.get('loginKey', null);
    }
    match /learners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isTeacher()
        || (signedIn() && request.auth.uid == uid
            && (classUnchanged()
                || (resource.data.get('classId', null) == null && request.resource.data.get('classId', null) == null)));
      allow delete: if isTeacher();

      match /attempts/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.learnerId == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow update: if false;
      }

      // A learner's work for an assignment. They can change it until it is marked.
      match /submissions/{assignmentId} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow create, update: if signedIn() && request.auth.uid == uid
                              && request.resource.data.learnerId == uid
                              && request.resource.data.assignmentId == assignmentId
                              && !exists(/databases/$(database)/documents/learners/$(uid)/feedback/$(assignmentId));
        allow delete: if isTeacher();
      }

      // The teacher's mark and comment. Only teachers write it.
      match /feedback/{assignmentId} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isTeacher();
      }

      // Tests: the start time is stamped by the server, answers can be sent once, within time.
      match /assessmentStarts/{aid} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.startedAt == request.time
                      && testOpen(aid);
        allow delete: if isTeacher();
      }
      match /assessmentAttempts/{aid} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.learnerId == uid
                      && request.resource.data.assessmentId == aid
                      && request.resource.data.submittedAt == request.time
                      && exists(/databases/$(database)/documents/learners/$(uid)/assessmentStarts/$(aid))
                      && inTime(uid, aid);
        allow delete: if isTeacher();
      }
      match /assessmentResults/{aid} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isTeacher();
      }

      // Portfolio (Ministry portfolio assessment), one per STEM year. The learner builds it and hands it in;
      // once handed in or marked only the teacher can change it, until the teacher returns it for changes.
      function portfolioDoc(y) {
        return /databases/$(database)/documents/learners/$(uid)/portfolio/$('y' + string(y));
      }
      function portfolioOpen(y) {
        return !exists(portfolioDoc(y)) || !(get(portfolioDoc(y)).data.status in ['handed-in', 'marked']);
      }
      match /portfolio/{y} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isTeacher();
        allow create, update: if signedIn() && request.auth.uid == uid
          && (resource == null || resource.data.status in ['building', 'returned'])
          && (request.resource.data.status in ['building', 'handed-in']
              || (resource != null && resource.data.status == 'returned' && request.resource.data.status == 'returned'));
      }
      match /portfolioItems/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.year is int
          && portfolioOpen(request.resource.data.year)
          && (resource == null || portfolioOpen(resource.data.year));
        allow delete: if signedIn() && request.auth.uid == uid && portfolioOpen(resource.data.year);
      }
      match /portfolioReviews/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isTeacher();
      }
      match /portfolioMark/{y} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isTeacher();
      }

      // Profile photo: the learner sends a small JPEG for approval; only a teacher can approve it.
      // Only the learner and teachers can see it.
      match /profile/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
        allow write: if isTeacher();
        allow create, update: if signedIn() && request.auth.uid == uid && docId == 'photo'
          && request.resource.data.pending is string
          && request.resource.data.pending.size() < 90000
          && request.resource.data.pending.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.rejectedReason == null
          && request.resource.data.approved == (resource == null ? null : resource.data.approved)
          && request.resource.data.approvedAt == (resource == null ? null : resource.data.approvedAt);
      }
    }

    // Teacher page: read all learners' attempts, submissions and feedback at once.
    match /{path=**}/attempts/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/submissions/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/feedback/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/portfolio/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/portfolioItems/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/portfolioMark/{id} {
      allow read: if isTeacher();
    }
    match /{path=**}/profile/{id} {
      allow read: if isTeacher();
    }

    // Lessons: written by teachers, readable by everyone signed in.
    match /lessons/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // Curriculum units (STEM 1 to 3) and their materials
    match /units/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    match /materials/{id} {
      allow read: if signedIn() && (resource.data.audience == 'learners' || isTeacher());
      allow write: if isTeacher();
    }

    // Assignments: set by teachers, visible to everyone signed in.
    match /assignments/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    match /{path=**}/assessmentStarts/{id} { allow read: if isTeacher(); }
    match /{path=**}/assessmentAttempts/{id} { allow read: if isTeacher(); }
    match /{path=**}/assessmentResults/{id} { allow read: if isTeacher(); }

    // Tests: settings visible to everyone signed in; questions once open; answers per keyVisible.
    match /assessments/{aid} {
      allow read: if signedIn();
      allow write: if isTeacher();
      match /content/{part} {
        allow read: if isTeacher()
          || (part == 'questions' && signedIn() && test(aid).published == true
              && (test(aid).opensAt == null || request.time >= test(aid).opensAt))
          || (part == 'key' && signedIn() && keyVisible(aid));
        allow write: if isTeacher();
      }
    }
  }
}
